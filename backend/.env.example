# Copy to .env and fill in real values. NEVER commit .env.
# Loaded by pydantic-settings from the backend/ working directory.

# Application
APP_ENV=development
DEBUG=false

# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cmp_portal
DB_USER=cmp_app
DB_PASSWORD=change-me
DB_ECHO=false

# Security — JWT_SECRET must be at least 16 characters.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated). The Vite dev proxy makes /api same-origin,
# so this mainly matters for direct-origin setups.
CORS_ORIGINS=http://localhost:5173

# Rate limiting (slowapi syntax)
# LOGIN_RATE_LIMIT=5/minute
# LOOKUP_RATE_LIMIT=10/minute

# Parent portal access-code verification.
#   true  (DEFAULT — production): parents must verify with the college-issued
#          access code after the branch + roll lookup before any record is shown.
#   false (DEMO ONLY — synthetic data): the lookup step issues the read-only
#          session directly without a code. Use ONLY with synthetic/demo
#          students; production deployments MUST keep this true. Staff
#          authentication and all other endpoints are unaffected either way.
# PARENT_VERIFICATION_ENABLED=true
